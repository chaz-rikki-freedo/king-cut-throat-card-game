 "rules": [
  {
   "id": "people",
   "between": [
    "people",
    "people"
   ],
   "min": "similar",
   "why": "Any two bots can share a table, and all ten share a list in Your profile."
  },
  {
   "id": "seats",
   "between": [
    "seats",
    "seats"
   ],
   "min": "similar",
   "why": "The three seats with no personality seated."
  },
  {
   "id": "modes",
   "between": [
    "modes",
    "modes"
   ],
   "min": "similar",
   "why": "The modes share the menu and the game history."
  },
  {
   "id": "people-signals",
   "between": [
    "people",
    "signals"
   ],
   "min": "similar",
   "why": "Names sit next to gold, red suits and results in the log and on the table."
  },
  {
   "id": "seats-signals",
   "between": [
    "seats",
    "signals"
   ],
   "min": "similar",
   "why": "As people-signals, for the seats with no personality seated."
  },
  {
   "id": "modes-signals",
   "between": [
    "modes",
    "signals"
   ],
   "min": "similar",
   "why": "A mode chip is a fill, like a gold button and the selection outline."
  },
  {
   "id": "modes-people",
   "between": [
    "modes",
    "people"
   ],
   "min": "lookalike",
   "why": "A mode is a chip and a name is text, so their form tells them apart; their colors must not be identical."
  }
